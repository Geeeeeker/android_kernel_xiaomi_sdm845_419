# Platform
CONFIG_MACH_XIAOMI=y
CONFIG_MACH_XIAOMI_SDM845=y

# QCACLD
CONFIG_QCA_CLD_WLAN=y

# exFAT
CONFIG_EXFAT_FS=y

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Speaker-ID
CONFIG_MFD_SPK_ID=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y

# Touchscreen
CONFIG_TOUCHSCREEN_COMMON=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y

# Xiaomi - dipper-q-oss
CONFIG_CIFS=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_NLS_CODEPAGE_950=y
CONFIG_NLS_UTF8=y
